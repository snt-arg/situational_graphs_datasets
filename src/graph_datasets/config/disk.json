{   
    "source": {
        "type": "disk",
        "folder_path": "/home/sven/project/situational_graphs_datasets/src/graph_datasets/output_dataset",
        "limit": 1,
        "disk_mode": "passthrough"
    },
    "noise":{
        "global":{
            "active": true,
            "translation": 0,
            "rotation": 1.0
        },
        "room": {
            "active": false,
            "translation": 0.01,
            "rotation": 0.003
        },
        "ws": {
            "active": false,
            "rotation": 0.012
        }
    },
    "multiview": {
        "number":2,
        "overlapping": 2
    },
    "training_split": {
        "val" : 0.1,
        "test" : 0.1
    },
    "postprocess": {
        "training": [],
        "final": [
            {"pp_name": "incremental_deconstruct", "save_dir": "./incremental","seed": 0, "include_init": true, "return_sequence": false}
        ]
    },
    "initial_features": {
        "nodes": {
            "ws": ["length"], "room":"center", "wall":"center"
        },
        "edges": {
            "[ws,ws]": ["centroids_distance", "angle_centroid_degrees", "relative_ang_normal"]
        }
    }
}
