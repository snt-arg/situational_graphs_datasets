{   
    "source": {
        "type": "msd",
        "pickle_path": "/home/adminpc/workspaces/reasoning_ws/src/msd/data/msd_from_notebook.pickle"
    },
    "noise":{
        "global":{
            "active": true,
            "translation": 0,
            "rotation": 1.0
        },
        "room": {
            "active": false,
            "translation": 0.01,
            "rotation": 0.003
        },
        "ws": {
            "active": false,
            "rotation": 0.012
        }
    },
    "multiview": {
        "number":2,
        "overlapping": 2
    },
    "training_split": {
        "val" : 0.1,
        "test" : 0.1
    },
    "postprocess": {
        "training": [
            {"pp_name": "unfreeze"},
            {"pp_name": "remove_self_loops"},
            {"pp_name": "add_floor_node"},
            {"pp_name": "add_stories", "add_floor_nodes": false,"n_stories": 4}
        ],
        "final": [
            {"pp_name": "K_near_neigh", "max": 10, "types":["ws"], "use_gt":false},
            {"pp_name": "remove_self_loops"}
            
        ]
    },
    "initial_features": {
        "nodes": {
            "ws": ["length"], "room":"center", "wall":"center"
        },
        "edges": {
            "[ws,ws]": ["centroids_distance", "angle_centroid_degrees", "relative_ang_normal"]
        }
    }
}
