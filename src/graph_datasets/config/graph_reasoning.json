{   
    "base_graphs": {
        "grid_dims" : [[50,200],[50,200]],
        "playground_size": [100, 100],
        "max_room_entry_size" : [100,100],
        "min_room_entry_size" : [10,10],
        "room_center_distances" : [0.1,0.1],
        "wall_thickness" : [0.16,0.2],
        "n_buildings" : 1000
    },
    "noise":{
        "global":{
            "active": true,
            "translation": 0,
            "rotation": 1.0
        },
        "room": {
            "active": false,
            "translation": 0.01,
            "rotation": 0.003
        },
        "ws": {
            "active": true,
            "rotation": 0.012
        }
    },
    "multiview": {
        "number":2,
        "overlapping": 2
    },
    "training_split": {
        "val" : 0.1,
        "test" : 0.1
    },
    "postprocess": {
        "training": [
            {"pp_name": "merge_room", "ratio": 0.5},
            {"pp_name": "dropout", "room": 0.2, "ws":0.0},
            {"pp_name": "ws_split", "ratio": 0.25},
            {"pp_name": "filter", "nodes": ["ws"], "edges":[
                [
                    "ws",
                    "ws_same_room",
                    "ws"
                ],[
                    "ws",
                    "ws_same_wall",
                    "ws"
                ]
            ]},
            {"pp_name": "dropout", "room": 0.0, "ws":0.25},
            {"pp_name": "ws_partial_occlusion", "ratio": 0.25},
            {"pp_name": "add_gt"},
            {"pp_name": "K_near_neigh", "max": 10, "types":["ws"], "use_gt":true},
            {"pp_name": "relabel_nodes", "mapping": false, "copy":true},
            {"pp_name": "remove_self_loops"},
            {"pp_name": "unfreeze"},
            {"pp_name": "add_x"}
        ],
        "final": [
            {"pp_name": "K_near_neigh", "max": 10, "types":["ws"], "use_gt":false},
            {"pp_name": "remove_self_loops"}
            
        ]
    },
    "initial_features": {
        "nodes": {
            "ws": ["length"], "room":"center", "wall":"center"
        },
        "edges": {
            "[ws,ws]": ["centroids_distance", "angle_centroid_degrees", "relative_ang_normal"]
        }
    }
}

