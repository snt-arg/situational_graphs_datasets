{  
    "source" : {
        "type": "synthetic",
        "base_graphs": {
            "grid_dims" : [[30,30],[30,30]],
            "playground_size": [100, 100],
            "max_room_entry_size" : [20,20],
            "min_room_entry_size" : [10,10],
            "room_center_distances" : [0.1,0.1],
            "wall_thickness" : [0.16,0.2],
            "n_buildings" : 1
        }
    },
    "noise":{
        "global":{
            "active": true,
            "translation": 0,
            "rotation": 1.0
        },
        "room": {
            "active": false,
            "translation": 0.01,
            "rotation": 0.003
        },
        "ws": {
            "active": true,
            "rotation": 0.012
        }
    },
    "multiview": {
        "number":2,
        "overlapping": 2
    },
    "training_split": {
        "val" : 0.0,
        "test" : 0.0
    },
    "postprocess": {
        "training": [
            {"pp_name": "filter", "nodes": ["ws", "room"], "edges":[
                [
                    "ws",
                    "ws_belongs_room",
                    "room"
                ]
            ]}
        ],
        "final": [
            {"pp_name": "K_near_neigh", "max": 15, "types":["ws"], "use_gt":false},
            {"pp_name": "remove_self_loops"}
        ]
    },
    "initial_features": {
        "nodes": {
            "ws": ["length"], "room":"center", "wall":"center"
        },
        "edges": {
            "[ws,ws]": ["centroids_distance", "angle_centroid_degrees", "relative_ang_normal"]
        }
    }
}

